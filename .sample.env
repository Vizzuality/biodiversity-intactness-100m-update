# Copy to .env and fill in. AWS creds come from the profile/role, not here.
AWS_REGION=us-west-2
AWS_PROFILE=

# Output run sub-prefix (out/<run_id>/...); defaults to v1_1
BII_RUN_ID=v1_1

# Override storage roots to a local dir to run off S3 (default: s3://<bucket>/...)
# BII_STAGED_ROOT=
# BII_OUT_ROOT=

# Batch (from `tofu apply` / infra outputs); required to submit array jobs
BII_BATCH_QUEUE=
BII_BATCH_JOB_DEF=
BII_BATCH_STAGE_JOB_DEF=

# Container image tag for local docker_run; defaults to "bii"
BII_STAGE_IMAGE=bii
